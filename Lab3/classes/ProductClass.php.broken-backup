    // ==================== PRODUCT DUPLICATE CHECK ====================

    /**
     * Check whether another product has the same details and image.
     *
     * Image filenames may differ even when the uploaded image contents
     * are identical, so compare SHA-256 hashes of the actual image files.
     */
    private function duplicateProductExists(
        $product_id,
        $product_cat,
        $product_brand,
        $product_title,
        $product_price,
        $product_desc,
        $product_image,
        $product_keywords
    ) {
        $checkSql = "SELECT p.product_id, p.product_image
                     FROM products p
                     INNER JOIN categories c
                         ON p.product_cat = c.cat_id
                     WHERE p.product_id != ?
                       AND p.product_brand = ?
                       AND LOWER(TRIM(c.cat_name)) = (
                           SELECT LOWER(TRIM(cat_name))
                           FROM categories
                           WHERE cat_id = ?
                       )
                       AND LOWER(TRIM(p.product_title)) =
                           LOWER(TRIM(?))
                       AND p.product_price = ?
                       AND TRIM(COALESCE(p.product_desc, '')) =
                           TRIM(?)
                       AND LOWER(TRIM(COALESCE(p.product_keywords, ''))) =
                           LOWER(TRIM(?))";

        $existingProducts = $this->fetchAll($checkSql, [
            $product_id,
            $product_brand,
            $product_cat,
            $product_title,
            $product_price,
            $product_desc,
            $product_keywords
        ]);

        if (empty($existingProducts)) {
            return false;
        }

        $imageDirectory = __DIR__ . '/../images/products/';

        $newImagePath = $imageDirectory . basename($product_image);

        if (!is_file($newImagePath)) {
            return false;
        }

        $newImageHash = hash_file('sha256', $newImagePath);

        if ($newImageHash === false) {
            return false;
        }

        foreach ($existingProducts as $existingProduct) {
            $existingImagePath = $imageDirectory .
                basename($existingProduct['product_image']);

            if (!is_file($existingImagePath)) {
                continue;
            }

            $existingImageHash = hash_file(
                'sha256',
                $existingImagePath
            );

            if (
                $existingImageHash !== false &&
                hash_equals($existingImageHash, $newImageHash)
            ) {
                return true;
            }
        }

        return false;
    }


